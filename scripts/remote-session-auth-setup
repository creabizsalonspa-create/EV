#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
python3 - <<'PY'
from pathlib import Path
p=Path('services/business-api/.env')
v=dict(line.split('=',1) for line in p.read_text().splitlines() if '=' in line and not line.startswith('#'))
clean=lambda x:x.strip('"\'')
if clean(v.get('APP_ENV',''))!='local' or clean(v.get('CSMS_SESSION_BRIDGE_ENABLED',''))!='true':raise SystemExit('Existing isolated local charging configuration is required.')
k='CSMS_REMOTE_AUTHORIZATION_ENABLED'
if k in v and clean(v[k]) not in ('true','false'):raise SystemExit('Unsupported remote authorization setting.')
if k not in v:
 with p.open('a') as f:f.write('\n'+k+'=true\n')
elif clean(v[k])=='false':p.write_text('\n'.join(k+'=true' if line.startswith(k+'=') else line for line in p.read_text().splitlines())+'\n')
# Explicit setup reloads the source extension, not credentials or persistent data.
Path('services/csms/rider/runtime/.reload-required').touch(mode=0o600)
PY
./scripts/rider-auth-setup
node --input-type=module - <<'JS'
import {randomUUID} from 'node:crypto';
const r=await fetch('http://127.0.0.1:8080/creabiz/rider-auth/capabilities?nonce='+randomUUID(),{signal:AbortSignal.timeout(5000)});
if(!r.ok||(await r.json()).remote_session_authorization!==true)throw Error('Source remote-session authorizer is not ready.');
console.log('Online canonical remote authorization configured; no offline fallback or production dispatch.');
JS
