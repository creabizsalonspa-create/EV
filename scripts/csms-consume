#!/usr/bin/env bash
# Local simulator observer shares loopback service ports; no physical commands.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
exec docker run --rm --init --network host --user "$(id -u):$(id -g)" -v "$root:/app" -w /app/services/business-api --entrypoint php composer:2@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc artisan csms:consume "$@"
