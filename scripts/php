#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
exec docker run --rm --user "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer -e COMPOSER_CAFILE=/etc/ssl/certs/host-ca.pem -e COMPOSER_USE_GITHUB_API=0 -v /etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/host-ca.pem:ro -v "$root:/app" -w /app/services/business-api --entrypoint php composer:2@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc "$@"
