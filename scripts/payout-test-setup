#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:---enable}" in
  --enable) payout_test_setting=true ;;
  --disable) payout_test_setting=false ;;
  *) echo 'Usage: scripts/payout-test-setup [--enable|--disable]' >&2; exit 2 ;;
esac
./scripts/php -r '
require "vendor/autoload.php";
$app = require "bootstrap/app.php";
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
if (!$app->environment("local", "testing") || config("payments.provider") !== "mock") {fwrite(STDERR, "Local mock configuration required.\n");exit(1);}
$p = ".env"; $text = file_get_contents($p);
$text = preg_replace("/^PAYOUT_TEST_ENABLED=.*\\R?/m", "", $text);
file_put_contents($p, rtrim($text)."\nPAYOUT_TEST_ENABLED=".$argv[1]."\n");
' "$payout_test_setting"
./scripts/php artisan config:clear
