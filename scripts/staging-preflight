#!/usr/bin/env python3
"""Non-destructive staging credential, exposure and Compose preflight.

This command never starts services or prints credential values.
"""
import argparse
import base64
import binascii
import ipaddress
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
DNS_LABEL = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
EMAIL = re.compile(r"^[^\s@]+@[^\s@]+\.[^\s@]+$")
PASSWORD = re.compile(r"^[A-Za-z0-9_!@#%^&*+.,:=-]{24,}$")
IMAGE_TAG = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$")


class UnsafeStagingConfiguration(ValueError):
    pass


def read_env(path: Path) -> dict[str, str]:
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
            raise UnsafeStagingConfiguration("Staging .env must be a regular, non-symlink file.")
        if info.st_mode & 0o077:
            raise UnsafeStagingConfiguration("Staging .env must be owner-only (chmod 600).")
        if hasattr(os, "getuid") and info.st_uid != os.getuid():
            raise UnsafeStagingConfiguration("Staging .env must be owned by the invoking user.")
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise UnsafeStagingConfiguration("Staging .env is unavailable or unreadable.") from exc
    values: dict[str, str] = {}
    for number, line in enumerate(raw.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        name, sep, value = line.partition("=")
        name = name.strip()
        if not sep or not KEY.fullmatch(name):
            raise UnsafeStagingConfiguration(f"Invalid environment entry at line {number}.")
        if name in values:
            raise UnsafeStagingConfiguration(f"Duplicate environment entry: {name}.")
        value = value.strip()
        if value.startswith(('"', "'")) or value.endswith(('"', "'")):
            raise UnsafeStagingConfiguration(f"Use unquoted, single-line values for {name}.")
        if "$"+"{" in value or "$(" in value or "$" in value or chr(96) in value:
            raise UnsafeStagingConfiguration(f"Shell/Compose expansion is not allowed in {name}.")
        values[name] = value
    return values


def validate(values: dict[str, str], *, allow_public: bool = False) -> list[str]:
    for required in ("APP_KEY", "DB_PASSWORD", "STAGING_HOST", "ACME_EMAIL"):
        if not values.get(required):
            raise UnsafeStagingConfiguration(f"Missing staging setting: {required}.")
    key = values["APP_KEY"]
    try:
        if not key.startswith("base64:") or len(base64.b64decode(key[7:], validate=True)) != 32:
            raise ValueError("Invalid key")
    except (ValueError, binascii.Error) as exc:
        raise UnsafeStagingConfiguration("APP_KEY must contain a valid 32-byte Laravel base64 key.") from exc
    if not PASSWORD.fullmatch(values["DB_PASSWORD"]):
        raise UnsafeStagingConfiguration("DB_PASSWORD must be >=24 unquoted characters without interpolation or whitespace.")
    host = values["STAGING_HOST"].lower()
    if (len(host) > 253 or host.endswith((".invalid", ".test", ".example", ".localhost"))
            or host in {"localhost", "127.0.0.1"} or "." not in host
            or not all(DNS_LABEL.fullmatch(label) for label in host.split("."))):
        raise UnsafeStagingConfiguration("STAGING_HOST must be a valid configured DNS hostname (not a placeholder or URL).")
    if not EMAIL.fullmatch(values["ACME_EMAIL"]):
        raise UnsafeStagingConfiguration("ACME_EMAIL must be a responsible email address.")
    if values.get("APP_ENV", "staging") != "staging":
        raise UnsafeStagingConfiguration("APP_ENV must remain staging.")
    if values.get("APP_DEBUG", "false").lower() not in {"false", "0", "off", "no"}:
        raise UnsafeStagingConfiguration("APP_DEBUG must remain disabled.")
    if values.get("CSMS_SIMULATOR_ENABLED", "false").lower() not in {"false", "0", "off", "no"}:
        raise UnsafeStagingConfiguration("Staging must not enable physical/simulated charger controls.")
    tag = values.get("EV_IMAGE_TAG", "local")
    if not IMAGE_TAG.fullmatch(tag):
        raise UnsafeStagingConfiguration("EV_IMAGE_TAG must be a simple local image tag.")
    bind = values.get("STAGING_BIND_IP", "127.0.0.1")
    try:
        ip = ipaddress.ip_address(bind)
    except ValueError as exc:
        raise UnsafeStagingConfiguration("STAGING_BIND_IP must be an explicit IP address.") from exc
    if not ip.is_loopback and not allow_public:
        raise UnsafeStagingConfiguration("Non-loopback staging exposure is blocked; require explicit --allow-public-bind authorization.")
    warnings = []
    if not ip.is_loopback:
        warnings.append("Non-loopback binding was expressly allowed for validation; public deployment is NOT authorized by this tool.")
    if values.get("MAIL_MAILER", "log") == "log":
        warnings.append("Email transport uses log; SMTP delivery is not accepted by this check.")
    warnings.append("TLS/ACME, ports, real payment, charger hardware, mobile builds and end-to-end behavior are not verified.")
    return warnings


def main() -> int:
    default_root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env-file", type=Path, default=default_root / "infra/staging/.env")
    parser.add_argument("--allow-public-bind", action="store_true", help="Validate a non-loopback address; never deploys")
    parser.add_argument("--check-compose", action="store_true", help="Run Docker Compose config --quiet, without starting containers")
    args = parser.parse_args()
    try:
        env_path = args.env_file.absolute()
        values = read_env(env_path)
        warnings = validate(values, allow_public=args.allow_public_bind)
        # Compose gives inherited shell variables precedence over .env. Fail closed.
        shadowed = [name for name, value in values.items() if name in os.environ and os.environ[name] != value]
        if shadowed:
            raise UnsafeStagingConfiguration("Shell environment overrides staging file settings: " + ", ".join(sorted(shadowed)))
        if args.check_compose:
            compose = default_root / "infra/staging/compose.yaml"
            if not compose.is_file():
                raise UnsafeStagingConfiguration("Staging Compose configuration is missing.")
            result = subprocess.run(
                ["docker", "compose", "--env-file", str(env_path), "-f", str(compose), "config", "--quiet"],
                cwd=str(compose.parent), text=True, capture_output=True, check=False,
                env={key: value for key, value in os.environ.items() if key not in values},
                timeout=30,
            )
            if result.returncode != 0:
                raise UnsafeStagingConfiguration("Docker Compose validation failed; inspect locally without publishing secrets.")
    except (UnsafeStagingConfiguration, FileNotFoundError, subprocess.TimeoutExpired) as exc:
        print("FAIL: " + str(exc), file=sys.stderr)
        return 2
    print("PASS: staging credentials, file permissions, loopback exposure and configuration guard validated; no services started.")
    for warning in warnings:
        print("LIMITATION: " + warning)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
