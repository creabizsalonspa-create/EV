#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
exec docker run --rm --init --network host --user "$(id -u):$(id -g)" \
  -e CSMS_SIMULATOR_ENABLED=true -e CSMS_COMMAND_WORKER_ENABLED=true \
  -e CSMS_GRAPHQL_URL=http://127.0.0.1:8095/v1/graphql -e CSMS_RIDER_SOURCE_API_URL=http://127.0.0.1:8080 \
  -v "$root:/app" -w /app/services/business-api --entrypoint php \
  composer:2@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc artisan csms:dispatch-pending "$@"
