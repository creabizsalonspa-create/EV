#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
./scripts/php /usr/bin/composer install --no-interaction --prefer-dist
if [[ ! -f services/business-api/.env ]]; then
  cp services/business-api/.env.example services/business-api/.env
  ./scripts/php artisan key:generate --no-interaction
fi
if [[ ! -f services/business-api/database/database.sqlite ]]; then
  touch services/business-api/database/database.sqlite
fi
./scripts/php artisan migrate --no-interaction
