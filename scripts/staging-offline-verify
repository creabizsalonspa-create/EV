#!/usr/bin/env bash
# Source-only validation of private EV staging safeguards. Never deploys or
# contacts GitHub, Docker, chargers, partner APIs or payment processors.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v node >/dev/null || ! command -v python3 >/dev/null; then
  echo 'FAIL: Node.js and Python3 are required for offline staging review.' >&2
  exit 2
fi

# Synthetic fixtures execute local mock CLI shims. Use a writable temporary
# root rather than HOME, which is read-only in managed cloud environments.
# Hosts with noexec temporary storage can explicitly choose an executable
# workspace root via EV_STAGING_TEST_TMPDIR; HOME is never reassigned.
# Only files under this mktemp-created directory are removed by the trap.
test_tmp=$(mktemp -d "${EV_STAGING_TEST_TMPDIR:-${TMPDIR:-/tmp}}/ev-staging-offline.XXXXXXXX")
trap 'rm -rf -- "$test_tmp"' EXIT
export TMPDIR="$test_tmp"

node --check scripts/staging-release.cjs
node --check scripts/staging-manual-rollback.cjs
node --check scripts/staging-env-integrity.cjs
node --check scripts/staging-compose-integrity.cjs

# Include safe synthetic client-demo checks in the offline staging gate.
# Deliberately EXCLUDE client-demo-lifecycle.cjs: it starts/stops Docker
# workers and belongs only to a separately owned integration lifecycle job.
for required in tests/staging-release.cjs tests/client-demo-readiness.cjs tests/demo-fixture-guard.cjs; do
  if [[ ! -f "$required" ]]; then
    echo 'FAIL: required staging/demo source-only regression missing.' >&2
    exit 2
  fi
done
mapfile -d '' cases < <(find tests -maxdepth 1 -type f \
  \( -name 'staging-*.cjs' -o -name 'client-demo-*.cjs' -o -name 'demo-fixture-guard.cjs' \) \
  ! -name 'client-demo-lifecycle.cjs' -print0 | sort -z)
if (( ${#cases[@]} < 1 )); then
  echo 'FAIL: staging or synthetic demo offline tests are missing.' >&2
  exit 2
fi
node --test "${cases[@]}"
PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s tests -p 'staging_ci_evidence_test.py'
printf 'PASS: local offline staging regressions completed. Hosted CI, staging, hardware, payments and production still unverified.\n'
