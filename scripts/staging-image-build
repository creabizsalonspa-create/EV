#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
image=${1:-creabiz-ev-business:local-review}
case "$image" in creabiz-ev-business:*) ;; *) echo 'Use a Crea-Biz review image tag.' >&2; exit 2 ;; esac
export BUILDX_CONFIG=${BUILDX_CONFIG:-/tmp/ev-staging-buildx}
mkdir -p "$BUILDX_CONFIG"
bundle=${EV_BUILD_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}
test -r "$bundle"
# Docker predefined proxy arguments are not declared as ARG/ENV in the image.
# CA trust stays a BuildKit secret; TLS and Debian package signatures remain on.
docker build --build-arg HTTP_PROXY --build-arg HTTPS_PROXY --build-arg NO_PROXY \
  --secret "id=ev_ca_bundle,src=$bundle" \
  -f infra/staging/Dockerfile -t "$image" .
./scripts/staging-image-check "$image"
