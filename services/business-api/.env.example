APP_NAME="Crea-Biz EV"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TLS charger admission (disabled until an authorized ingress is configured)
CSMS_INGRESS_AUTH_ENABLED=false
CSMS_INGRESS_ALLOW_LOCAL_HTTP=false
CSMS_INGRESS_AUTH_SECRET=

# Saved mandates and automatic collection: supported test mode only, opt-in.
PAYMENT_PROVIDER=mock
STRIPE_TEST_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
PAYMENT_HOSTED_RETURN_URL=
# Required HTTPS URL ending /payments/corporate-hosted-return for Stripe TEST collection.
CORPORATE_PAYMENT_HOSTED_RETURN_URL=
SUBSCRIPTION_COLLECTION_ENABLED=false

# Sandbox only. Production payout mutations are rejected even when enabled.
PAYOUT_TEST_ENABLED=false
PAYOUTS_STRIPE_TEST_WEBHOOK_SECRET=

# Non-cash promotional economics; commercial activation requires reviewed rules.
LOYALTY_TEST_ENABLED=false

# Commercial package workflows; publisher delivery calls require this separate HMAC key.
COMMERCIAL_CAMPAIGNS_ENABLED=false
COMMERCIAL_CAMPAIGNS_DELIVERY_SECRET=

# Optional approved geocoding/routing plan; disabled until terms/credentials are approved.
DISCOVERY_GEOCODING_ENABLED=false
DISCOVERY_ROUTING_ENABLED=false
DISCOVERY_GEOAPIFY_KEY=
DISCOVERY_PROVIDER_REQUESTS_PER_MINUTE=30
DISCOVERY_PROVIDER_REQUESTS_PER_DAY=5000

# Local simulator reset operations remain opt-in. Never enables production commands.
CSMS_SAFE_RESET_ENABLED=false
CSMS_OPERATIONS_BASE_URL=http://citrine:8080
CSMS_COMMAND_WORKER_ENABLED=false
CSMS_REMOTE_AUTHORIZATION_ENABLED=false

CSMS_SIGNED_FIRMWARE_ENABLED=false
CSMS_FIRMWARE_SIGNER_PINS=
CSMS_FIRMWARE_DOWNLOAD_BASE=http://127.0.0.1:8000

# Local read-only fault observer; never grants device-command authority.
CSMS_FAULT_WORKER_ENABLED=false

# Optional managed OCPI2.2.1 exchange: independently approved public URL/party roles.
# No tokens belong in metadata or Git; bootstrap values stay in OCPI_*_TOKEN variables.
OCPI_LOCAL_CREDENTIALS_JSON={}

# Incoming OCPI enrollment metadata uses registration_direction="incoming" and
# inbound_token_env="OCPI_PARTNER_INBOUND_TOKEN" in OCPI_CONNECTIONS_JSON.
# Inject the Base64 bootstrap separately; Admin prepares a 30-minute window.

# Explicit local simulator reads of fixed non-secret operating settings.
CSMS_CONFIGURATION_READ_ENABLED=false
