APP_NAME="Crea-Biz EV"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Local multi-process OCPP simulation uses bounded SQLite writer contention
# and WAL so concurrent session/queue reads do not block a source observation.
# PostgreSQL staging/production configuration is unaffected.
DB_SQLITE_BUSY_TIMEOUT_MS=5000
DB_SQLITE_JOURNAL_MODE=WAL
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Generic email digests remain disabled until approved SMTP/origin configuration and user consent.
NOTIFICATION_EMAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TLS charger admission (disabled until an authorized ingress is configured)
CSMS_INGRESS_AUTH_ENABLED=false
CSMS_INGRESS_ALLOW_LOCAL_HTTP=false
CSMS_INGRESS_AUTH_SECRET=

# Saved mandates and automatic collection: supported test mode only, opt-in.
PAYMENT_PROVIDER=mock
STRIPE_TEST_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
PAYMENT_HOSTED_RETURN_URL=
# Required HTTPS URL ending /payments/corporate-hosted-return for Stripe TEST collection.
CORPORATE_PAYMENT_HOSTED_RETURN_URL=
SUBSCRIPTION_COLLECTION_ENABLED=false

# Sandbox only. Production payout mutations are rejected even when enabled.
PAYOUT_TEST_ENABLED=false
PAYOUTS_STRIPE_TEST_WEBHOOK_SECRET=

# Non-cash promotional economics; commercial activation requires reviewed rules.
LOYALTY_TEST_ENABLED=false

# Commercial package workflows; publisher delivery calls require this separate HMAC key.
COMMERCIAL_CAMPAIGNS_ENABLED=false
COMMERCIAL_CAMPAIGNS_DELIVERY_SECRET=

# Optional approved geocoding/routing plan; disabled until terms/credentials are approved.
DISCOVERY_GEOCODING_ENABLED=false
DISCOVERY_ROUTING_ENABLED=false
DISCOVERY_GEOAPIFY_KEY=
# Open Charge Map is optional, discovery-only and disabled until attribution
# terms are approved and a private server-only API key is configured.
OCM_DISCOVERY_ENABLED=false
OCM_DISCOVERY_TERMS_ACCEPTED=false
OCM_DISCOVERY_API_KEY=
DISCOVERY_PROVIDER_REQUESTS_PER_MINUTE=30
DISCOVERY_PROVIDER_REQUESTS_PER_DAY=5000

# Local simulator reset operations remain opt-in. Never enables production commands.
CSMS_SAFE_RESET_ENABLED=false
CSMS_AVAILABILITY_COMMAND_ENABLED=false
CSMS_OPERATIONS_BASE_URL=http://citrine:8080
CSMS_COMMAND_WORKER_ENABLED=false
CSMS_REMOTE_AUTHORIZATION_ENABLED=false

CSMS_SIGNED_FIRMWARE_ENABLED=false
CSMS_FIRMWARE_SIGNER_PINS=
CSMS_FIRMWARE_DOWNLOAD_BASE=http://127.0.0.1:8000

# Local read-only fault observer; never grants device-command authority.
CSMS_FAULT_WORKER_ENABLED=false

# Optional managed OCPI2.2.1 exchange: independently approved public URL/party roles.
# No tokens belong in metadata or Git; bootstrap values stay in OCPI_*_TOKEN variables.
OCPI_LOCAL_CREDENTIALS_JSON={}
# Optional named identities selected per managed connection by local_credential_profile.
OCPI_LOCAL_CREDENTIAL_PROFILES_JSON={}
# Explicit CPO catalog push is restricted to approved local/testing sandbox contracts.
OCPI_CPO_PUSH_ENABLED=false

# Incoming OCPI enrollment metadata uses registration_direction="incoming" and
# inbound_token_env="OCPI_PARTNER_INBOUND_TOKEN" in OCPI_CONNECTIONS_JSON.
# Inject the Base64 bootstrap separately; Admin prepares a 30-minute window.

# Explicit local simulator reads of fixed non-secret operating settings.
CSMS_CONFIGURATION_READ_ENABLED=false

# Explicit approved sandbox roaming only; no local invoice or live command authority.
OCPI_TEST_COMMANDS_ENABLED=false
# Explicit isolated local simulator diagnostic files; never production dispatch.
CSMS_DIAGNOSTIC_LOGS_ENABLED=false
CSMS_DIAGNOSTIC_UPLOAD_ORIGIN=http://127.0.0.1:8000

# Separate approved local TEST invoice consent only; never automatic OCPI billing.
OCPI_TEST_BILLING_ENABLED=false
# Opt-in labelled simulated vehicle battery alerts; local/testing only.
EV_BATTERY_SIMULATOR_ENABLED=false

# Phone verification stays disabled until an approved SMS provider is configured.
PHONE_VERIFICATION_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Use a restricted Verify API key for production; account auth-token fallback is local/test only.
TWILIO_VERIFY_API_KEY_SID=
TWILIO_VERIFY_API_KEY_SECRET=

# Partner polling needs approved connection metadata and separate owner consent.
OCPI_SCHEDULED_SYNC_ENABLED=false
# Aggregate process observations only; no queue payloads or remote probes.
OPERATIONAL_HEALTH_ENABLED=true
# Valid incident thresholds: 1–10000 ready jobs and 60–3600 seconds old.
OPERATIONAL_QUEUE_BACKLOG_READY_COUNT=25
OPERATIONAL_QUEUE_BACKLOG_AGE_SECONDS=300

# Report/ingestion age policy only; never physical availability. Valid60..604800.
OCPI_CATALOG_MAX_AGE_SECONDS=86400

# Manual noncash inventory remains disabled unless deployment owners explicitly
# review the terms and fulfillment process. Never enables PSPs or point spending.
LOYALTY_NONCASH_MODE=disabled
LOYALTY_NONCASH_APPROVAL_REFERENCE=
LOYALTY_NONCASH_TERMS_SHA256=
LOYALTY_NONCASH_FULFILLMENT_REVIEWED=false
# Separate reviewed live canonical invoice/capture integration prerequisite.
LOYALTY_REFERRAL_VERIFIED_LIVE_SOURCE_READY=false
