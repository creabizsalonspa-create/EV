FROM php:8.5-cli-bookworm@sha256:d4f6e10eb393de7e3a7a88e8b88e139072dd3ae297f6a5dada8257e6fe32c585
RUN --mount=type=secret,id=host_ca,target=/tmp/host-ca.pem cp /tmp/host-ca.pem /etc/ssl/certs/ca-certificates.crt && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && apt-get update && apt-get install -y --no-install-recommends libpq-dev && rm -rf /var/lib/apt/lists/* && mkdir /tmp/pdo-pgsql && tar -xJf /usr/src/php.tar.xz --wildcards --strip-components=3 -C /tmp/pdo-pgsql '*/ext/pdo_pgsql/*' && cd /tmp/pdo-pgsql && phpize && ./configure --with-pdo-pgsql=/usr && make -j2 && make install && docker-php-ext-enable pdo_pgsql && cd / && rm -rf /tmp/pdo-pgsql
