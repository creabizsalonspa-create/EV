#!/usr/bin/env python3
"""Bound simulator startup, preserve attempts, never retry Dart/test failures."""
import json
import os
import re
import signal
import subprocess
import sys
from pathlib import Path


def may_recover_startup(result, text):
    """Only a successful build stalled before connecting to Dart is retryable."""
    entered = ('DEVICE:', 'Connecting to service protocol',
               'Connected to the VM Service', 'VM Service URL on device',
               'TestFailure', 'Expected:', 'Some tests failed')
    return (result != 0 and 'Xcode build done.' in text
            and 'Waiting for VM Service port to be available' in text
            and not any(marker in text for marker in entered))


def verified_success(result, text):
    return (result == 0 and 'All tests passed!' in text
            and 'DEVICE: Keychain session restored' in text
            and 'DEVICE: exact Arabic vendor pricing verified' in text
            and 'DEVICE: native vendor onboarding and private PDF preview verified' in text
            and 'DEVICE: customer favorites and private catalog status verified' in text
            and 'DEVICE: customer map privacy consent navigation verified; no external tiles' in text
            and 'DEVICE: consented one-shot GPS and sourced charging-stop route verified; synthetic platform/provider' in text
            and 'DEVICE: scoped noncash native loyalty evidence verified; synthetic economics' in text
            and 'DEVICE: private financial PDF and durable operation storage verified; synthetic document' in text
            and 'DEVICE: explicit native subscription enrollment verified; synthetic test billing' in text
            and 'DEVICE: private case evidence consent and multipart upload verified; synthetic internal review' in text)


def owned_simulator(devices, device, run, attempt):
    if not re.fullmatch(r'[0-9a-fA-F-]{36}', device):
        return False
    if not run.isdigit() or not attempt.isdigit():
        return False
    matches = [d for group in devices.get('devices', {}).values()
               for d in group if d.get('udid') == device]
    return (len(matches) == 1
            and matches[0].get('name') == f'CreaBiz-{run}-{attempt}')


def stop(process):
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=15)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()


def capture(directory, device, attempt):
    # Preserve the first startup failure before rebooting the isolated simulator.
    subprocess.run(['xcrun', 'simctl', 'io', device, 'screenshot',
                    str(directory / f'ios-attempt-{attempt}.png')],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    with (directory / f'ios-attempt-{attempt}.log').open('w') as output:
        subprocess.run(['xcrun', 'simctl', 'spawn', device, 'log', 'show',
                        '--last', '20m', '--style', 'compact',
                        '--predicate', 'process == "Runner"'], stdout=output,
                       stderr=subprocess.STDOUT, timeout=30)


def reboot_owned(device, directory, attempt):
    result = subprocess.run(['xcrun', 'simctl', 'list', 'devices', '--json'],
                            capture_output=True, text=True, check=True, timeout=30)
    if not owned_simulator(json.loads(result.stdout), device,
                           os.environ.get('GITHUB_RUN_ID', ''),
                           os.environ.get('GITHUB_RUN_ATTEMPT', '')):
        raise RuntimeError('Refusing to reboot a simulator not owned by this CI run.')
    capture(directory, device, attempt)
    subprocess.run(['xcrun', 'simctl', 'shutdown', device], check=True, timeout=30)
    subprocess.run(['xcrun', 'simctl', 'boot', device], check=True, timeout=30)
    subprocess.run(['xcrun', 'simctl', 'bootstatus', device, '-b'],
                   check=True, timeout=180)


def main():
    directory = Path(os.environ['RUNNER_TEMP'])
    device = os.environ['EV_IOS_DEVICE_ID']
    command = ['flutter', 'test', 'integration_test/native_flow_test.dart',
               '-d', device, '--reporter', 'expanded', '--verbose']
    combined = directory / 'native-device.log'
    combined.write_text('')
    final = 1
    for attempt in (1, 2):
        output = directory / f'native-device-attempt-{attempt}.log'
        with output.open('w') as log:
            process = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT,
                                       start_new_session=True)
            try:
                result = process.wait(timeout=660)
            except subprocess.TimeoutExpired:
                print(f'Attempt {attempt} exceeded 11 minutes; collecting diagnostics.', flush=True)
                stop(process)
                result = 124
        text = output.read_text(errors='replace')
        with combined.open('a') as log:
            log.write(f'\n=== Attempt {attempt}, exit {result} ===\n' + text)
        if verified_success(result, text):
            final = 0
            print('\n'.join(text.splitlines()[-100:]))
            break
        final = result or 1
        if attempt == 1 and may_recover_startup(result, text):
            print('No Dart phase or assertion started; rebooting only the run-owned simulator once.', flush=True)
            reboot_owned(device, directory, attempt)
            continue
        relevant = [line for line in text.splitlines()
                    if re.search(r'DEVICE:|[Ee]rror|[Ff]ail|[Ll]aunch|debug connection|VM Service|Installing', line)]
        print('\n'.join(relevant[-80:]))
        print('\n'.join(text.splitlines()[-100:]))
        break
    return final


if __name__ == '__main__':
    sys.exit(main())
