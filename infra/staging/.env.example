# Copy privately to .env, mode 0600. Never commit its values.
APP_KEY=
STAGING_HOST=
ACME_EMAIL=
DB_PASSWORD=
EV_IMAGE_TAG=local
# Loopback-only by default. Public exposure requires explicitly authorized infrastructure.
STAGING_BIND_IP=127.0.0.1
EV_BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
MAIL_MAILER=log
# Configure a real mail transport in the private environment before email delivery QA.
