# Copy privately to .env, mode 0600. Never commit its values.
APP_KEY=
STAGING_HOST=
ACME_EMAIL=
DB_PASSWORD=
EV_IMAGE_TAG=sha-<exact-commit-sha>
# Supply a commit-scoped image tag after a verified build, not 'latest'.
# Preserve APP_KEY through restoration; never rotate it in a restore rehearsal.
# These capabilities stay off in staging unless a separate approved environment is built.
CSMS_SESSION_BRIDGE_ENABLED=false
CSMS_FAULT_WORKER_ENABLED=false
CSMS_COMMAND_WORKER_ENABLED=false
CSMS_REMOTE_AUTHORIZATION_ENABLED=false
OCPI_TEST_COMMANDS_ENABLED=false
SUBSCRIPTION_COLLECTION_ENABLED=false
PAYOUT_TEST_ENABLED=false
CSMS_INGRESS_AUTH_ENABLED=false
EV_BATTERY_SIMULATOR_ENABLED=false
# Loopback-only by default. Public exposure requires explicitly authorized infrastructure.
STAGING_BIND_IP=127.0.0.1
EV_BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Configure a real mail transport in the private environment before email delivery QA.
